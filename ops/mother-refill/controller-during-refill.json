              "if": [
                {
                  "condition": "template",
                  "value_template": "{{ not is_state('switch.mother_humidifier','off') }}"
                }
              ],
              "then": [
                {
                  "action": "switch.turn_off",
                  "target": {
                    "entity_id": "switch.mother_humidifier"
                  }
                }
              ]
            },
            {
              "if": [
                {
                  "condition": "template",
                  "value_template": "{{ not is_state('switch.mother_fan','off') }}"
                }
              ],
              "then": [
                {
                  "action": "switch.turn_off",
                  "target": {
                    "entity_id": "switch.mother_fan"
                  }
                }
              ]
            },
            {
              "if": [
                {
                  "condition": "template",
                  "value_template": "{{ not is_state('switch.mother_intake_fan','off') }}"
                }
